# Copy to .env for local (non-Docker) development: `cp .env.example .env`
DATABASE_URL=postgresql+asyncpg://wealthportfolio:wealthportfolio@localhost:5432/wealthportfolio

JWT_SECRET=change-me-to-a-long-random-string
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me

DEFAULT_BASE_CURRENCY=USD
AGENT_TIMEZONE=Asia/Shanghai
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=change-me-to-a-fernet-key
