# Local backend without Docker. For the full stack use the repository-level
# .env.example and docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://wealthportfolio:replace-postgres-password@localhost:5432/wealthportfolio
REDIS_URL=redis://:replace-redis-password@localhost:6379/0
CELERY_BROKER_URL=amqp://wealthportfolio_app:replace-rabbitmq-password@localhost:5672/wealthportfolio
CELERY_RESULT_BACKEND=redis://:replace-redis-password@localhost:6379/1

JWT_SECRET=replace-jwt-with-at-least-64-random-characters
JWT_ISSUER=wealthportfolio-api
JWT_AUDIENCE=wealthportfolio-web
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-admin-with-a-unique-password

DEFAULT_BASE_CURRENCY=USD
AGENT_TIMEZONE=Asia/Shanghai
AGENT_JOB_BACKEND=celery
AGENT_INLINE_FALLBACK=false
PRICE_JOB_BACKEND=celery
PRICE_INLINE_FALLBACK=false
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

APP_ENCRYPTION_KEY=replace-app-encryption-with-at-least-64-random-characters
ENCRYPTION_PROVIDER=local
LLM_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

DOCUMENT_JOB_BACKEND=celery
DOCUMENT_INLINE_FALLBACK=false
DOCUMENT_STORAGE_BACKEND=minio
DOCUMENT_STORAGE_ENDPOINT=http://localhost:9000
DOCUMENT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
DOCUMENT_STORAGE_BUCKET=wealthportfolio-private
DOCUMENT_STORAGE_ACCESS_KEY=wealthportfolio_local
DOCUMENT_STORAGE_SECRET_KEY=replace-minio-password
DOCUMENT_STORAGE_REGION=us-east-1
DOCUMENT_STORAGE_SECURE=false
DOCUMENT_CLAMAV_HOST=localhost
DOCUMENT_CLAMAV_PORT=3310
DOCUMENT_CLAMAV_REQUIRED=true
DOCUMENT_TESSERACT_LANGUAGES=eng+chi_sim
