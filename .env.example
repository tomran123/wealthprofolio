# Local Docker Compose only. Never reuse these example values in production.
# Copy with `cp .env.example .env`, then replace every `replace-*` value.
# Generate URL-safe values, for example:
#   openssl rand -hex 32
#
# Redis and RabbitMQ passwords are embedded in connection URLs. Keep them
# URL-safe (hex/base64url) or percent-encode them before use.

# Local infrastructure
POSTGRES_PASSWORD=replace-postgres-with-64-hex-characters
REDIS_PASSWORD=replace-redis-with-64-hex-characters
RABBITMQ_USER=wealthportfolio_app
RABBITMQ_PASSWORD=replace-rabbitmq-with-64-hex-characters
MINIO_ROOT_USER=wealthportfolio_local
MINIO_ROOT_PASSWORD=replace-minio-with-64-hex-characters
MINIO_BUCKET=wealthportfolio-private
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Application authentication
JWT_SECRET=replace-jwt-with-at-least-64-random-characters
JWT_ISSUER=wealthportfolio-api
JWT_AUDIENCE=wealthportfolio-web
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-admin-with-a-unique-password

# Application
DEFAULT_BASE_CURRENCY=USD
AGENT_TIMEZONE=Asia/Shanghai
AGENT_JOB_BACKEND=celery
AGENT_INLINE_FALLBACK=false
PRICE_JOB_BACKEND=celery
PRICE_INLINE_FALLBACK=false
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AES-256-GCM envelope wrapping key for local development.
APP_ENCRYPTION_KEY=replace-app-encryption-with-at-least-64-random-characters
ENCRYPTION_PROVIDER=local

# Legacy Fernet reads only. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# Optional runtime tuning
CELERY_CONCURRENCY=2
IMAGE_TAG=local
DOCUMENT_TESSERACT_LANGUAGES=eng+chi_sim

# Optional encrypted local backup profile:
#   docker compose --profile backup up -d backup
# Generate a separate passphrase. Leaving this empty makes the backup
# container fail closed.
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
