# Codex authentication is stored in the user profile, never in this repository.
.codex/auth.json
.codex/history.jsonl
.codex/log/

# Secrets / environment
.env
backups/*
!backups/.gitkeep
backend/.env
frontend/.env.local

# Local Terraform state and real cloud inputs
deploy/alicloud/terraform/.terraform/
deploy/alicloud/terraform/*.tfstate
deploy/alicloud/terraform/*.tfstate.*
deploy/alicloud/terraform/*.tfvars
!deploy/alicloud/terraform/terraform.tfvars.example

# Python
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts

# Uploaded user data (screenshots, photos) - added in a later phase
backend/uploads/
